// Physical schema V2 — implements docs/REQUIREMENTS-V2.md (ADR-030) over the v1
// design in docs/ARCHITECTURE.md §5. PostgreSQL everywhere (ADR-033 executes the
// ADR-002 switch; local dev/tests run an embedded Postgres — see scripts/).
// Enum-like columns are String (Zod + unions in src/lib/pipeline-engine/constants.ts);
// money is Int piasters (ADR-018); percentages are Int basis points. Field groups
// are child records so history accumulates (SPEC §5.2, A-2).
// V2: PortalDeal merged INTO Lead (same ids — child rows survived the migration);
// roles renamed (bsystems_admin/sales/agent/partner); milestones carry commission +
// expected dates; statements/payments + notifications are new subsystems.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String?        @unique // staff/admin login; partner login (ADR-030 §8)
  phone         String?        @unique // agent login, normalized (ADR-008)
  passwordHash  String
  /* founder directive: the admin sees every user's password in Users. The hash
     stays the AUTH source; this is an admin-visibility copy, captured whenever
     a password is set (accounts predating the column show "—" until reset).
     TRADEOFF (flagged): anyone with admin access or a DB/backup dump reads it. */
  passwordPlain String?
  active        Boolean        @default(true) // A-4 kill-switch
  /* ADR-066 (founder: "block some admins from accessing accounting or data
     vault") — PER-ADMIN module access. Deliberately FLAGS, not roles: this
     codebase iterates the role union in a dozen places (bsRoleOf, landingFor,
     bucketFor, ownerTypeForRole, the assignable-owner roster, the To-Do scope,
     the proxy) and a capability role would have to be excluded from every one.
     Both default TRUE, so every admin that exists keeps exactly the access he
     has today and no backfill is needed. They NARROW bsystems_admin and can
     never widen anything: a non-admin is refused by role long before a flag is
     read (see canUseModule in lib/auth/roles.ts). */
  canAccessAccounting Boolean   @default(true)
  canAccessVault      Boolean   @default(true)
  /* founder: agent self-signup is a REQUEST — "pending" until the admin approves
     it on the Registrations page ("approved" | "pending" | "rejected"). Admin-
     created, seeded, and partner-provisioned accounts are approved from birth. */
  registrationStatus String    @default("approved")
  roles         UserRole[]
  portalRep     PortalRep? // agent profile (model name kept from v1)
  partner       Partner? // partner-company account link (V2 §8)
  /* founder: an AGENT card on the Partners & Agents board mints this account
     through the separate admin-only "Create the agent's account" action (§7.2b,
     row PP-4a) — NEVER at the stage move, which since ADR-059 asks for no
     credentials at all. The link back to the card that created it (SetNull on a
     hard account delete: the card stays converted, like Partner.userId). */
  agentProspect PartnerProspect? @relation("ProspectAgent")
  /* who typed the record in (ADR-051). Declared as RELATIONS on purpose: a
     userId column with no relation is invisible to cascade planning
     (IMPLEMENTATION.md, ADR-049). SET NULL — deleting the person who entered a
     lead must never delete the lead. */
  createdLeads     Lead[]            @relation("LeadCreator")
  createdProspects PartnerProspect[] @relation("ProspectCreator")
  /* ADR-069 — the records this person was the FIRST to message on WhatsApp.
     Declared as relations for the same reason the two above are: a bare userId
     column is invisible to cascade planning. SET NULL — deleting the messenger
     must never delete the lead, and the denormalised label keeps the chip's
     sentence readable afterwards. */
  whatsappMarkedLeads     Lead[]            @relation("LeadWhatsappSender")
  whatsappMarkedProspects PartnerProspect[] @relation("ProspectWhatsappSender")
  ownedLeads    Lead[]         @relation("LeadOwner")
  notifications Notification[]
  /* ADR-065 — the DEVICES this person asked to be notified on. Cascade: an
     account that is deleted must stop receiving push, and there is nothing to
     preserve (a browser re-subscribes in one press). */
  pushSubscriptions PushSubscription[]
  leadComments  LeadComment[]  @relation("CommentAuthor")
  todoCompletions TodoDone[]   @relation("TodoCompleter") // ADR-062 — marks this user checked
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserRole {
  // roles: byteforce_staff | bsystems_admin | bsystems_sales | bsystems_agent
  //      | bsystems_partner | bsystems_data_entry (ADR-051 — add-only)
  userId String
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model SalesRep {
  // internal rep cards (§6.1) — not accounts
  id             String     @id @default(cuid())
  brand          String // byteforce | bsystems
  name           String
  leads          Lead[]
  ownedFollowUps FollowUp[]

  @@index([brand])
}

model Lead {
  // UNIFIED lead (V2 §1): ByteForce internal leads + every B-Systems lead
  // (internal / agent / partner / admin buckets).
  id           String     @id @default(cuid())
  brand        String // byteforce | bsystems
  ownerType    String     @default("internal") // internal | agent | partner | admin (V2 §1)
  ownerUserId  String? // agent/partner/admin owner account
  salesRepId   String? // internal bucket assignment (A-6: null = unassigned)
  source       String     @default("direct") // direct | partner (§5.5 attribution)
  partnerId    String? // referral attribution — permanent
  name         String
  number       String
  email        String?
  type         String // cold_call | event_data | personal_connection | campaign_lead
  description  String?
  position     String? // ex-portal deal fields (V2 §1)
  companyName  String?
  industry     String?
  requirements String?
  stage        String     @default("new") // BF: new|following_up|meeting_setting|sending_proposal|won|lost
  // BS adds: negotiation (V2 §1)
  readyToClose Boolean    @default(false) // V2 §3 flag — admin notified
  noAnswer     Boolean    @default(false) // founder: "didn't answer" card marker (ADR-039) — a flag, not a stage
  /* ADR-064 — "make the didn't answer button a counter so we can know how many
     times we tried": how many attempts this card has recorded. `noAnswer` above
     is KEPT and maintained as `noAnswerCount > 0` — the backup/restore path
     recreates rows verbatim, so dropping a column would break restoring any
     existing backup file, and every reader/query/test on the flag keeps working. */
  noAnswerCount Int       @default(0)
  archived     Boolean    @default(false) // founder: archive (ADR-043) — soft-hide, restorable, no data loss
  archivedAt   DateTime?
  /* ADR-069 (founder: "when I click on the WhatsApp button, it should turn to be
     green to signal that I already sent WhatsApp to that prospect or to that
     lead … it signals not just for my user, for any user that we have contacted
     this lead through WhatsApp") — the mark lives on the RECORD, so every reader
     sees it. NULL = nobody has messaged them yet.

     It records the FIRST message and keeps it: a second press never overwrites
     these three, and there is no unmark. Every press still writes its own
     ActivityLog row (trigger `whatsapp_sent`), so "who most recently messaged
     them" is answerable from the history without a second pair of columns that
     would compete with the chip for meaning.

     The label is denormalised beside the FK — the LeadComment.authorLabel /
     Statement.closerLabel convention — so the chip still reads "sent by Omar"
     after that account is permanently deleted and the FK is SET NULL. */
  whatsappSentAt      DateTime?
  whatsappSentById    String?
  whatsappSentByLabel String?
  whatsappSentBy      User?      @relation("LeadWhatsappSender", fields: [whatsappSentById], references: [id], onDelete: SetNull)
  /* ADR-051 — who TYPED this in, which is never who OWNS it. Set on every
     create path (audit data), and the data-entry role's own list reads it. */
  createdByUserId String?
  createdBy    User?      @relation("LeadCreator", fields: [createdByUserId], references: [id])
  owner        User?      @relation("LeadOwner", fields: [ownerUserId], references: [id])
  salesRep     SalesRep?  @relation(fields: [salesRepId], references: [id])
  partner      Partner?   @relation(fields: [partnerId], references: [id])
  followUps    FollowUp[]
  meetings     Meeting[]
  proposals    Proposal[]
  lostInfo     LostInfo[]
  negotiationNotes NegotiationNote[]
  wonInfo      WonInfo?
  client       Client?
  wonDeal      WonDeal?
  comments     LeadComment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([brand, stage])
  @@index([brand, ownerType])
  @@index([ownerUserId])
  @@index([partnerId])
  @@index([createdByUserId])
  @@index([whatsappSentById]) // ADR-069 — a SET NULL FK: indexed like createdByUserId, so deleting an account never scans every lead
}

model FollowUp {
  // §6.2 — history accumulates. Exactly one parent FK set (service invariant).
  id                String           @id @default(cuid())
  leadId            String?
  partnerProspectId String?
  context           String // initial | after_proposal | after_meeting
  dueAt             DateTime // ONE UTC instant; agent forms collect date-only (V2 §3 — time 09:00 Cairo default)
  /* ADR-063 — did the submitter actually CHOOSE the slot? `dueAt` stays the one
     source of the instant; this only says whether its clock is the caller's or
     the ADR-061 09:00 Cairo default, so a blank submission renders date-only
     and a chosen time renders with its clock. */
  dueTimeSet        Boolean          @default(false)
  method            String // call | message | visit
  ownerSalesRepId   String?
  ownerPortalRepId  String?
  followingUpWith   String?
  lead              Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospect          PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  ownerSalesRep     SalesRep?        @relation(fields: [ownerSalesRepId], references: [id])
  ownerPortalRep    PortalRep?       @relation(fields: [ownerPortalRepId], references: [id])
  todoDone          TodoDone? // ADR-062 — manual To-Do completion mark
  createdAt         DateTime         @default(now())
}

model Meeting {
  // §6.2 + V2 §3 agent flow (arranged=agreed-with-client; !arranged+datetime = proposed slot)
  id                 String           @id @default(cuid())
  leadId             String?
  partnerProspectId  String?
  arranged           Boolean          @default(false)
  datetime           DateTime?
  mode               String? // online | offline
  withAttendees      String?
  technicalSupport   String?
  needsTechnical     Boolean? // V2 §3 agent question
  outcome            String? // attended | cancelled | delayed
  outcomeDestination String?
  lead               Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospect           PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  todoDone           TodoDone? // ADR-062 — manual To-Do completion mark
  createdAt          DateTime         @default(now())
}

model Proposal {
  // §6.2
  id             String    @id @default(cuid())
  leadId         String?
  service        String
  estimatedValue Int? // piasters (ADR-018)
  sent           Boolean   @default(false)
  sentAt         DateTime?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

model LostInfo {
  // §6.2 — reason required
  id                String           @id @default(cuid())
  leadId            String?
  partnerProspectId String?
  reason            String
  lead              Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospect          PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
}

model NegotiationNote {
  // V2 §1 — the negotiation stage's group (note per entry, accumulates)
  id        String   @id @default(cuid())
  leadId    String
  note      String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model WonInfo {
  // ByteForce Won fields (v1 §6.2, T-9) — unchanged
  id              String   @id @default(cuid())
  leadId          String   @unique
  estimatedValue  Int
  technicalOwner  String
  collectedAmount Int
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model Client {
  // ByteForce §6.4 (B-Systems Clients section dropped in V2)
  id             String    @id @default(cuid())
  brand          String
  leadId         String?   @unique
  name           String
  number         String
  service        String?
  estimatedValue Int?
  collected      Int?
  toBeCollected  Int?
  dueDate        DateTime?
  retainer       Boolean   @default(false)
  technicalOwner String?
  lead           Lead?     @relation(fields: [leadId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([brand])
}

model PartnerProspect {
  // App B Partners & Agents pipeline (§7.2) + V2 §6 numbers rework.
  // founder: ONE board, TWO kinds of card — a partner company or an agent.
  // ADR-059: the stages, forms and records are identical for both kinds; only
  // the kind-specific fields and what QUALIFIED does differ (PP-4 creates the
  // directory Partner, PP-6 is a pure move), so requiredness is CONDITIONAL
  // and the columns are nullable here: partner ⇒ companyName + businessActivity,
  // agent ⇒ address + speciality (mirroring the public agent signup form).
  id                  String       @id @default(cuid())
  kind                String       @default("partner") // partner | agent
  name                String
  companyName         String? // partner only
  role                String? // partner only
  email               String?
  number              String // primary/registered number
  nonAnsweringNumbers String       @default("[]") // JSON array — V2 §6
  alternativeNumbers  String       @default("[]") // JSON array — unbounded
  businessActivity    String? // partner only
  address             String? // agent only (signup field)
  speciality          String? // agent only (signup field)
  description         String?
  stage               String       @default("lead")
  converted           Boolean      @default(false)
  agentUserId         String?      @unique // set by createAgentAccount (§7.2b / PP-4a), never by a stage move
  agentUser           User?        @relation("ProspectAgent", fields: [agentUserId], references: [id])
  createdByUserId     String? // ADR-051 — who typed the card in
  createdBy           User?        @relation("ProspectCreator", fields: [createdByUserId], references: [id])
  /* ADR-069 — the same WhatsApp mark the Lead carries, for the same reason: the
     partner/agent card wears the identical chip on the board, on its detail, on
     the partner directory row and (through `agentUserId`) in the Agents list, so
     the state has to live on the record they all read. See Lead above for the
     first-press / denormalised-label reasoning. */
  whatsappSentAt      DateTime?
  whatsappSentById    String?
  whatsappSentByLabel String?
  whatsappSentBy      User?        @relation("ProspectWhatsappSender", fields: [whatsappSentById], references: [id], onDelete: SetNull)
  followUps           FollowUp[]
  meetings            Meeting[]
  lostInfo            LostInfo[]
  // every Attachment hanging off this card: cold-call recordings AND, for an
  // agent card, the CV collected at creation (queries filter by `kind`)
  recordings          Attachment[]
  partner             Partner?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([stage])
  @@index([kind])
  @@index([createdByUserId])
  @@index([whatsappSentById]) // ADR-069 — see Lead
}

model Partner {
  // §7.3 directory + V2 §8 partner ACCOUNT link
  id               String          @id @default(cuid())
  prospectId       String          @unique
  userId           String?         @unique // set by createPartnerLogin (§7.2b / PP-4a); null until an admin mints it
  companyName      String
  keyPersonName    String
  keyPersonRole    String
  address          String
  number           String
  email            String?
  businessActivity String
  importance       String
  dateJoined       DateTime        @default(now())
  prospect         PartnerProspect @relation(fields: [prospectId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  leads            Lead[]
}

model PortalRep {
  // AGENT profile (model name kept from v1 to avoid a rename migration)
  id             String     @id @default(cuid())
  userId         String     @unique
  firstName      String
  lastName       String
  address        String
  speciality     String
  cv             Attachment?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedFollowUps FollowUp[]
}

model WonDeal {
  // V2 §4/§5 — B-Systems won record on the unified Lead
  id                     String       @id @default(cuid())
  leadId                 String       @unique
  estimatedValue         Int? // piasters
  totalCommissionPercent Int? // BASIS POINTS (V2 §4 — percentage, not amount)
  contractDate           DateTime? // V2 §5
  lead                   Lead         @relation(fields: [leadId], references: [id])
  milestones             Milestone[]
  attachments            Attachment[] // proposal pdf / contract pdf (V2 §5)
  createdAt              DateTime     @default(now())
}

model Milestone {
  // V2 §4 — name, value, closer's commission, expected start/end; sequential locks (P-7/P-8)
  id              String     @id @default(cuid())
  wonDealId       String
  index           Int
  label           String? // defaults to "Milestone n"
  value           Int // piasters
  commissionValue Int? // piasters — what the closer receives (V2 §4)
  expectedStart   DateTime?
  expectedEnd     DateTime?
  completed       Boolean    @default(false)
  completedAt     DateTime?
  wonDeal         WonDeal    @relation(fields: [wonDealId], references: [id], onDelete: Cascade)
  statement       Statement?
  todoDone        TodoDone? // ADR-062 — manual To-Do completion mark

  @@unique([wonDealId, index])
}

model Statement {
  // V2 §7 — generated from a checked milestone; then visible in the closer's Payments
  id             String       @id @default(cuid())
  code           String       @unique // ST-#### sequential
  milestoneId    String       @unique
  clientName     String
  milestoneLabel String
  milestoneValue Int // piasters
  percentBp      Int // % of the milestone, basis points
  amount         Int // piasters the closer receives
  adjustments    Int          @default(0) // piasters, signed
  expectedDate   DateTime?
  closerUserId   String?
  closerLabel    String
  status         String       @default("pending") // pending | paid
  paidAt         DateTime?
  milestone      Milestone    @relation(fields: [milestoneId], references: [id])
  proofs         Attachment[] // payment proof image (V2 §7)
  todoDone       TodoDone? // ADR-062 — manual To-Do completion mark
  createdAt      DateTime     @default(now())
}

model TodoDone {
  // Founder 2.2/2.3 (ADR-062) — the MANUAL half of To-Do completion. One row =
  // "this task was checked done today". Keyed to the UNDERLYING dated record
  // (never a lead, never a rendered string) so a NEW follow-up on the same lead
  // is a new id and always arrives unchecked. Exactly ONE of the four FKs set
  // (service invariant — the FollowUp dual-parent pattern); each is UNIQUE so a
  // record carries at most one mark. All four cascade: a deleted record retires
  // its mark silently. AUTO completion is never stored here — the projection
  // derives it (ADR-041 philosophy).
  id               String     @id @default(cuid())
  followUpId       String?    @unique
  meetingId        String?    @unique
  statementId      String?    @unique
  milestoneId      String?    @unique
  /* the task's due instant AT CHECK TIME. The projection honours a mark only
     while this equals the record's CURRENT due instant — so a meeting
     rescheduled in place (same id, new datetime) resets to unchecked with zero
     hooks in the reschedule path. */
  dueAt            DateTime
  completedById    String?
  completedByLabel String // label survives account deletion (LeadComment.authorLabel convention)
  completedAt      DateTime   @default(now())
  followUp         FollowUp?  @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  meeting          Meeting?   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  statement        Statement? @relation(fields: [statementId], references: [id], onDelete: Cascade)
  milestone        Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  completedBy      User?      @relation("TodoCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  /* a mark is valid for the Cairo day it was made (money must reappear
     tomorrow) — the projection filters on this window */
  @@index([completedAt])
}

model Notification {
  // V2 §10 — in-app; userId null = every admin
  id        String    @id @default(cuid())
  userId    String?
  type      String // meeting_request | ready_to_close | registration | mention
  title     String
  body      String
  leadId    String?
  readAt    DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model PushSubscription {
  /* ADR-065 (founder: "I want it to shoot me actual notifications") — one row
     per DEVICE that agreed to receive web push, exactly as the browser's
     PushSubscription describes it. One person has several (phone, laptop,
     the installed home-screen app), so the key is the ENDPOINT, not the user:
     the endpoint IS the device's address at its push service, it is unique
     across the world, and re-subscribing the same device must refresh the row
     rather than mint a second one.

     `endpoint` unique also carries the ownership rule: a device that signs into
     a different account re-points to whoever is signed in now, so the previous
     account can never keep pushing to a phone it no longer holds.

     No secret of OURS lives here: p256dh/auth are the BROWSER's public
     subscription material, useless without the endpoint they belong to. The
     server's VAPID private key is read from the environment and is never
     stored in the database. */
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String // the device's public key (base64url)
  auth       String // the device's auth secret (base64url)
  userAgent  String   @default("") // a human label so a person can tell devices apart
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // refreshed every time the device re-subscribes
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Attachment {
  // kinds: cv | recording | proposal | contract | payment_proof (V2 §5/§7)
  //      | vault_sheet | vault_document | vault_attachment (ADR-053)
  id                String           @id @default(cuid())
  kind              String
  portalRepId       String?          @unique
  partnerProspectId String?
  wonDealId         String?
  statementId       String?
  /* ADR-053 — vault file homes. Sheet/document FKs are deliberately NOT unique:
     replacing a file APPENDS a new row and the predecessors stay servable, so
     the vault's never-delete rule covers the files too (newest = current). */
  vaultSheetId      String?
  vaultDocumentId   String?
  vaultTaskId       String?
  filename          String
  storageKey        String
  mime              String
  size              Int
  rep               PortalRep?       @relation(fields: [portalRepId], references: [id])
  prospect          PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  wonDeal           WonDeal?         @relation(fields: [wonDealId], references: [id])
  statement         Statement?       @relation(fields: [statementId], references: [id])
  vaultSheet        VaultSheet?      @relation(fields: [vaultSheetId], references: [id], onDelete: Cascade)
  vaultDocument     VaultDocument?   @relation(fields: [vaultDocumentId], references: [id], onDelete: Cascade)
  vaultTask         VaultTask?       @relation(fields: [vaultTaskId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())

  @@index([vaultSheetId])
  @@index([vaultDocumentId])
  @@index([vaultTaskId])
}

model LeadComment {
  // founder: a mini chat inside every lead — questions, follow-ups, @mentions,
  // so whoever talks to the lead has the full picture. Author label survives
  // account deletion (ActivityLog convention).
  id           String   @id @default(cuid())
  leadId       String
  authorUserId String?
  authorLabel  String
  body         String
  mentions     String   @default("[]") // JSON [{userId,name}] — resolved server-side
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User?    @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([leadId, createdAt])
}

model ActivityLog {
  // §5.6
  id         String   @id @default(cuid())
  entityType String // lead | partner_prospect | won_deal | client | partner | portal_rep | statement | user
  entityId   String
  actorId    String?
  actorLabel String
  action     String
  fromStage  String?
  toStage    String?
  trigger    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model UndoEntry {
  // Founder: "an undo button that undoes the last action I did on the system"
  // (ADR-045). One row per UNDOABLE mutation, written inside that mutation's
  // own transaction. `payload` is the INVERSE — a snapshot of the prior state
  // plus the ids this action created — never a replay log. Rows are consumed
  // (never deleted) so a double-click cannot apply twice, and non-undoable
  // actions consume the user's outstanding rows so the button never offers to
  // revert something older than the last thing that happened.
  id          String    @id @default(cuid())
  userId      String // undo is personal: only its author may apply it
  kind        String // lead_event | lead_no_answer | lead_ready | lead_archive | lead_update | lead_create | prospect_event
  entityType  String // lead | partner_prospect
  entityId    String
  label       String // English snapshot of what will be reverted
  labelAr     String // Arabic snapshot (bilingual UI, V5)
  fingerprint String // the entity's updatedAt at write time — changed since = refuse
  payload     Json
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?

  @@index([userId, consumedAt, createdAt])
}

/* ============================ ACCOUNTING (ADR-052) ============================
   Rebuild-on-top of the reference SPA (docs/INTEGRATION-PLAN.md §2–3): the
   SPA's migrate()/state shape is the field spec. Every row carries `company`
   ("byteforce" | "bsystems" — the Brand union; company is a FILTER, not a
   tenant). Money is Int piasters (EGP ×100 on import — lossless; ADR-018).
   Months are "YYYY-MM" and day-dates are "YYYY-MM-DD" STRINGS, exactly as the
   SPA stores them: the whole engine is lexicographic month arithmetic on
   calendar facts, not instants — a DateTime would re-introduce the timezone
   day-shift class of bug for zero gain (ADR-052). Payroll is NEVER a stored
   row: the engine derives it from roster segments at read time; only the
   approval marks (AcctPayrollPayment) and linked manual overrides persist. */

model AcctIncome {
  id            String  @id @default(cuid())
  company       String // byteforce | bsystems
  month         String // "YYYY-MM" the item belongs to (issue month)
  type          String // invoice | media_fee | consulting | loan_in | other
  client        String  @default("") // free text this phase (linking = Phase 7)
  serviceLine   String  @default("") // dept id or "" (SPA: income always has one)
  amount        Int // piasters
  note          String  @default("")
  collected     Boolean @default(false)
  collectedDate String? // "YYYY-MM-DD" — cash basis: counts when collected
  paidMonth     String? // "YYYY-MM" the cash landed in (incomeMonth precedence)
  mediaEntryId  String? // fee income minted by a media "received" (SPA mediaRef)
  mediaEntry    AcctMediaEntry? @relation(fields: [mediaEntryId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([company, month])
  @@index([company, collected])
}

model AcctExpense {
  id          String  @id @default(cuid())
  company     String
  month       String // "YYYY-MM"
  type        String // payroll | subscription | media | media_campaign | rent | freelancer | tax | admin | loan_repay | other
  name        String  @default("") // payee
  serviceLine String  @default("") // dept id or "" = shared overhead
  amount      Int // piasters
  /* payroll net = amount − deduction + bonus. The SPA's expenseAmount() reads
     these though its current form never writes them — legacy rows in the
     export may carry them, so they are kept (the SPA is the spec). */
  deduction   Int?
  bonus       Int?
  note        String  @default("")
  paid        Boolean @default(false) // approval gate: on-hold never touches cash
  paidDate    String? // "YYYY-MM-DD"
  /* a manual payroll row LINKED to a person replaces that person's derived
     auto-salary for its month; unlinked = extra on top (SPA autoPayroll). */
  rosterId    String?
  rosterMember AcctRosterMember? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company, month])
}

model AcctRosterMember {
  id          String  @id @default(cuid())
  company     String
  name        String
  role        String  @default("")
  serviceLine String  @default("")
  account     String  @default("") // payment account no.
  since       String // "YYYY-MM" first month on payroll
  segments    AcctRosterSegment[]
  payrollPayments AcctPayrollPayment[]
  linkedExpenses  AcctExpense[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company])
}

model AcctRosterSegment {
  // effective-dated salary/active history: a change "as of" month m applies
  // from m onward; earlier months keep their previous segment (SPA memberAt).
  id       String  @id @default(cuid())
  memberId String
  from     String // "YYYY-MM"
  salary   Int // piasters
  active   Boolean @default(true)
  member   AcctRosterMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, from]) // memberUpsert replaces the same-month segment
}

model AcctPayrollPayment {
  // the SPA's payrollPaid map ("month:rosterId" → paidDate) as rows: the
  // approval mark for one person's DERIVED salary in one month.
  id       String @id @default(cuid())
  company  String
  memberId String
  month    String // "YYYY-MM"
  paidDate String // "YYYY-MM-DD"
  member   AcctRosterMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, month])
  @@index([company, month])
}

model AcctTreasuryMove {
  id        String @id @default(cuid())
  company   String
  month     String // "YYYY-MM"
  kind      String // deposit | withdraw
  label     String @default("")
  amount    Int // piasters
  date      String // "YYYY-MM-DD"
  tag       String @default("") // "" | media | loan (SPA provenance tag)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company, month])
}

model AcctLoan {
  id        String @id @default(cuid())
  company   String
  direction String // borrowed (liability) | lent (receivable)
  party     String
  principal Int // piasters
  date      String // "YYYY-MM-DD"
  dueDate   String @default("")
  note      String @default("")
  payments  AcctLoanPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company])
}

model AcctLoanPayment {
  id     String @id @default(cuid())
  loanId String
  amount Int // piasters
  date   String // "YYYY-MM-DD"
  note   String @default("")
  loan   AcctLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model AcctMediaEntry {
  // pass-through ledger: client ad budget is NOT revenue — only the fee is.
  id        String @id @default(cuid())
  company   String
  month     String // "YYYY-MM"
  client    String
  type      String // received | sent
  amount    Int // piasters
  feeAmount Int? // received only: the agency fee minted as income
  date      String // "YYYY-MM-DD"
  ref       String @default("")
  feeIncomes AcctIncome[]
  createdAt DateTime @default(now())

  @@index([company, month])
}

model AcctTarget {
  id      String @id @default(cuid())
  company String
  period  String // "YYYY-MM"
  goal    Int // piasters (collected-income goal)

  @@unique([company, period])
}

model AcctSettings {
  // per-company scalars: today only the system opening balance.
  id             String @id @default(cuid())
  company        String @unique
  openingBalance Int    @default(0) // piasters, cash before the first month
}

/* ============================= DATA VAULT (ADR-053) =============================
   Rebuild-on-top of the reference Vault app (docs/INTEGRATION-PLAN.md Phases 4-5,
   founder decisions §7.1-§7.4): its schema/services are the SPEC, nothing is
   ported. Admin-only — employees are assignee CARDS, never logins (every auth
   column of the old Employee model is deleted, not migrated). Company is a tag
   ("byteforce" | "bsystems"; null on employees/tasks = both/none). Calendar facts
   (deadline, sheet dateCreated, count as-of) are "YYYY-MM-DD" STRINGS per the
   ADR-052 §1 precedent — the lateness rule is day arithmetic on Cairo calendar
   dates, and instants would re-introduce day-shift bugs. Files live as
   Attachment rows through the storage abstraction (§7.2 — no S3 anywhere).
   Archive = flag + timestamp (ADR-043 pattern), restorable, never deleted. */

model VaultEmployee {
  // assignee card: name / title / company. NOT an account (founder §7.3).
  id        String      @id @default(cuid())
  name      String
  title     String?
  company   String? // byteforce | bsystems | null = both
  active    Boolean     @default(true) // deactivate, never delete (old BR-13)
  tasks     VaultTask[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([active])
}

model VaultForm {
  id         String    @id @default(cuid())
  company    String // byteforce | bsystems
  name       String
  url        String // http/https only (old BR-01); duplicate URL = 409 handshake
  notes      String?
  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([company, archived])
  @@index([url])
}

model VaultSheet {
  id              String       @id @default(cuid())
  company         String
  name            String
  type            String // leads | employees | data | campaign_leads
  /* old BR-02 — a link XOR an uploaded file, never both, never neither.
     Enforced by the Zod discriminated union AND re-asserted in the service;
     the columns are nullable because the DB cannot express the union. */
  storage         String // link | file
  url             String?
  dateCreated     String // "YYYY-MM-DD" — user-entered, distinct from createdAt
  recordCount     Int?
  recordCountAsOf String? // "YYYY-MM-DD" — required whenever the count is manual (old BR-03)
  notes           String?
  files           Attachment[] // newest = current; predecessors stay (version history)
  archived        Boolean      @default(false)
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([company, archived])
  @@index([type])
}

model VaultDocument {
  id          String       @id @default(cuid())
  company     String
  name        String
  description String?
  type        String // contract | proposal | invoice | report | presentation | brand_asset | legal | hr | other
  files       Attachment[] // required ≥1 (service invariant); newest = current
  archived    Boolean      @default(false)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([company, archived])
  @@index([type])
}

model VaultTask {
  id          String        @id @default(cuid())
  employeeId  String
  employee    VaultEmployee @relation(fields: [employeeId], references: [id])
  name        String
  description String?
  company     String? // optional (old D-05)
  deadline    String // "YYYY-MM-DD" calendar date, evaluated in Cairo (old D-06)
  status      String        @default("open") // open | completed — completion ONLY via completeVaultTask
  /* the RESULT GATE (old BR-05): a task cannot complete without a recorded
     result — text, ≥1 file attachment, or ≥1 link. resultLinks is a JSON array
     [{url,label}] (house precedent: nonAnsweringNumbers, mentions). */
  resultText  String?
  resultLinks String        @default("[]")
  completedAt DateTime? // server-stamped (old BR-06)
  wasLate     Boolean? // FROZEN at completion (old BR-07) — no recompute path exists
  daysLate    Int? // frozen with wasLate; deadline edits never touch either
  attachments Attachment[] // kind vault_attachment — result files
  archived    Boolean       @default(false)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([employeeId, status, deadline])
  @@index([company, archived])
}
