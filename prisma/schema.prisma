// Physical schema V2 — implements docs/REQUIREMENTS-V2.md (ADR-030) over the v1
// design in docs/ARCHITECTURE.md §5. PostgreSQL everywhere (ADR-033 executes the
// ADR-002 switch; local dev/tests run an embedded Postgres — see scripts/).
// Enum-like columns are String (Zod + unions in src/lib/pipeline-engine/constants.ts);
// money is Int piasters (ADR-018); percentages are Int basis points. Field groups
// are child records so history accumulates (SPEC §5.2, A-2).
// V2: PortalDeal merged INTO Lead (same ids — child rows survived the migration);
// roles renamed (bsystems_admin/sales/agent/partner); milestones carry commission +
// expected dates; statements/payments + notifications are new subsystems.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String?        @unique // staff/admin login; partner login (ADR-030 §8)
  phone         String?        @unique // agent login, normalized (ADR-008)
  passwordHash  String
  /* founder directive: the admin sees every user's password in Users. The hash
     stays the AUTH source; this is an admin-visibility copy, captured whenever
     a password is set (accounts predating the column show "—" until reset).
     TRADEOFF (flagged): anyone with admin access or a DB/backup dump reads it. */
  passwordPlain String?
  active        Boolean        @default(true) // A-4 kill-switch
  /* founder: agent self-signup is a REQUEST — "pending" until the admin approves
     it on the Registrations page ("approved" | "pending" | "rejected"). Admin-
     created, seeded, and partner-provisioned accounts are approved from birth. */
  registrationStatus String    @default("approved")
  roles         UserRole[]
  portalRep     PortalRep? // agent profile (model name kept from v1)
  partner       Partner? // partner-company account link (V2 §8)
  /* founder: an AGENT card on the Partners & Agents board mints this account at
     its Won gate — the link back to the card that created it (SetNull on a hard
     account delete: the card stays converted, exactly like Partner.userId). */
  agentProspect PartnerProspect? @relation("ProspectAgent")
  /* who typed the record in (ADR-051). Declared as RELATIONS on purpose: a
     userId column with no relation is invisible to cascade planning
     (IMPLEMENTATION.md, ADR-049). SET NULL — deleting the person who entered a
     lead must never delete the lead. */
  createdLeads     Lead[]            @relation("LeadCreator")
  createdProspects PartnerProspect[] @relation("ProspectCreator")
  ownedLeads    Lead[]         @relation("LeadOwner")
  notifications Notification[]
  leadComments  LeadComment[]  @relation("CommentAuthor")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserRole {
  // roles: byteforce_staff | bsystems_admin | bsystems_sales | bsystems_agent
  //      | bsystems_partner | bsystems_data_entry (ADR-051 — add-only)
  userId String
  role   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model SalesRep {
  // internal rep cards (§6.1) — not accounts
  id             String     @id @default(cuid())
  brand          String // byteforce | bsystems
  name           String
  leads          Lead[]
  ownedFollowUps FollowUp[]

  @@index([brand])
}

model Lead {
  // UNIFIED lead (V2 §1): ByteForce internal leads + every B-Systems lead
  // (internal / agent / partner / admin buckets).
  id           String     @id @default(cuid())
  brand        String // byteforce | bsystems
  ownerType    String     @default("internal") // internal | agent | partner | admin (V2 §1)
  ownerUserId  String? // agent/partner/admin owner account
  salesRepId   String? // internal bucket assignment (A-6: null = unassigned)
  source       String     @default("direct") // direct | partner (§5.5 attribution)
  partnerId    String? // referral attribution — permanent
  name         String
  number       String
  email        String?
  type         String // cold_call | event_data | personal_connection | campaign_lead
  description  String?
  position     String? // ex-portal deal fields (V2 §1)
  companyName  String?
  industry     String?
  requirements String?
  stage        String     @default("new") // BF: new|following_up|meeting_setting|sending_proposal|won|lost
  // BS adds: negotiation (V2 §1)
  readyToClose Boolean    @default(false) // V2 §3 flag — admin notified
  noAnswer     Boolean    @default(false) // founder: "didn't answer" card marker (ADR-039) — a flag, not a stage
  archived     Boolean    @default(false) // founder: archive (ADR-043) — soft-hide, restorable, no data loss
  archivedAt   DateTime?
  /* ADR-051 — who TYPED this in, which is never who OWNS it. Set on every
     create path (audit data), and the data-entry role's own list reads it. */
  createdByUserId String?
  createdBy    User?      @relation("LeadCreator", fields: [createdByUserId], references: [id])
  owner        User?      @relation("LeadOwner", fields: [ownerUserId], references: [id])
  salesRep     SalesRep?  @relation(fields: [salesRepId], references: [id])
  partner      Partner?   @relation(fields: [partnerId], references: [id])
  followUps    FollowUp[]
  meetings     Meeting[]
  proposals    Proposal[]
  lostInfo     LostInfo[]
  negotiationNotes NegotiationNote[]
  wonInfo      WonInfo?
  client       Client?
  wonDeal      WonDeal?
  comments     LeadComment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([brand, stage])
  @@index([brand, ownerType])
  @@index([ownerUserId])
  @@index([partnerId])
  @@index([createdByUserId])
}

model FollowUp {
  // §6.2 — history accumulates. Exactly one parent FK set (service invariant).
  id                String           @id @default(cuid())
  leadId            String?
  partnerProspectId String?
  context           String // initial | after_proposal | after_meeting
  dueAt             DateTime // ONE UTC instant; agent forms collect date-only (V2 §3 — time 09:00 Cairo default)
  method            String // call | message | visit
  ownerSalesRepId   String?
  ownerPortalRepId  String?
  followingUpWith   String?
  lead              Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospect          PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  ownerSalesRep     SalesRep?        @relation(fields: [ownerSalesRepId], references: [id])
  ownerPortalRep    PortalRep?       @relation(fields: [ownerPortalRepId], references: [id])
  createdAt         DateTime         @default(now())
}

model Meeting {
  // §6.2 + V2 §3 agent flow (arranged=agreed-with-client; !arranged+datetime = proposed slot)
  id                 String           @id @default(cuid())
  leadId             String?
  partnerProspectId  String?
  arranged           Boolean          @default(false)
  datetime           DateTime?
  mode               String? // online | offline
  withAttendees      String?
  technicalSupport   String?
  needsTechnical     Boolean? // V2 §3 agent question
  outcome            String? // attended | cancelled | delayed
  outcomeDestination String?
  lead               Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospect           PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
}

model Proposal {
  // §6.2
  id             String    @id @default(cuid())
  leadId         String?
  service        String
  estimatedValue Int? // piasters (ADR-018)
  sent           Boolean   @default(false)
  sentAt         DateTime?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

model LostInfo {
  // §6.2 — reason required
  id                String           @id @default(cuid())
  leadId            String?
  partnerProspectId String?
  reason            String
  lead              Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospect          PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
}

model NegotiationNote {
  // V2 §1 — the negotiation stage's group (note per entry, accumulates)
  id        String   @id @default(cuid())
  leadId    String
  note      String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model WonInfo {
  // ByteForce Won fields (v1 §6.2, T-9) — unchanged
  id              String   @id @default(cuid())
  leadId          String   @unique
  estimatedValue  Int
  technicalOwner  String
  collectedAmount Int
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model Client {
  // ByteForce §6.4 (B-Systems Clients section dropped in V2)
  id             String    @id @default(cuid())
  brand          String
  leadId         String?   @unique
  name           String
  number         String
  service        String?
  estimatedValue Int?
  collected      Int?
  toBeCollected  Int?
  dueDate        DateTime?
  retainer       Boolean   @default(false)
  technicalOwner String?
  lead           Lead?     @relation(fields: [leadId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([brand])
}

model PartnerProspect {
  // App B Partners & Agents pipeline (§7.2) + V2 §6 numbers rework.
  // founder: ONE board, TWO kinds of card — a partner company or an agent.
  // The stages, forms and records are identical; only the kind-specific fields
  // and the Won gate differ, so requiredness is CONDITIONAL (Zod superRefine)
  // and the columns are nullable here: partner ⇒ companyName + businessActivity,
  // agent ⇒ address + speciality (mirroring the public agent signup form).
  id                  String       @id @default(cuid())
  kind                String       @default("partner") // partner | agent
  name                String
  companyName         String? // partner only
  role                String? // partner only
  email               String?
  number              String // primary/registered number
  nonAnsweringNumbers String       @default("[]") // JSON array — V2 §6
  alternativeNumbers  String       @default("[]") // JSON array — unbounded
  businessActivity    String? // partner only
  address             String? // agent only (signup field)
  speciality          String? // agent only (signup field)
  description         String?
  stage               String       @default("lead")
  converted           Boolean      @default(false)
  agentUserId         String?      @unique // set by the won_agent gate
  agentUser           User?        @relation("ProspectAgent", fields: [agentUserId], references: [id])
  createdByUserId     String? // ADR-051 — who typed the card in
  createdBy           User?        @relation("ProspectCreator", fields: [createdByUserId], references: [id])
  followUps           FollowUp[]
  meetings            Meeting[]
  lostInfo            LostInfo[]
  // every Attachment hanging off this card: cold-call recordings AND, for an
  // agent card, the CV collected at creation (queries filter by `kind`)
  recordings          Attachment[]
  partner             Partner?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([stage])
  @@index([kind])
  @@index([createdByUserId])
}

model Partner {
  // §7.3 directory + V2 §8 partner ACCOUNT link
  id               String          @id @default(cuid())
  prospectId       String          @unique
  userId           String?         @unique // auto-provisioned account (V2 §8)
  companyName      String
  keyPersonName    String
  keyPersonRole    String
  address          String
  number           String
  email            String?
  businessActivity String
  importance       String
  dateJoined       DateTime        @default(now())
  prospect         PartnerProspect @relation(fields: [prospectId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  leads            Lead[]
}

model PortalRep {
  // AGENT profile (model name kept from v1 to avoid a rename migration)
  id             String     @id @default(cuid())
  userId         String     @unique
  firstName      String
  lastName       String
  address        String
  speciality     String
  cv             Attachment?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedFollowUps FollowUp[]
}

model WonDeal {
  // V2 §4/§5 — B-Systems won record on the unified Lead
  id                     String       @id @default(cuid())
  leadId                 String       @unique
  estimatedValue         Int? // piasters
  totalCommissionPercent Int? // BASIS POINTS (V2 §4 — percentage, not amount)
  contractDate           DateTime? // V2 §5
  lead                   Lead         @relation(fields: [leadId], references: [id])
  milestones             Milestone[]
  attachments            Attachment[] // proposal pdf / contract pdf (V2 §5)
  createdAt              DateTime     @default(now())
}

model Milestone {
  // V2 §4 — name, value, closer's commission, expected start/end; sequential locks (P-7/P-8)
  id              String     @id @default(cuid())
  wonDealId       String
  index           Int
  label           String? // defaults to "Milestone n"
  value           Int // piasters
  commissionValue Int? // piasters — what the closer receives (V2 §4)
  expectedStart   DateTime?
  expectedEnd     DateTime?
  completed       Boolean    @default(false)
  completedAt     DateTime?
  wonDeal         WonDeal    @relation(fields: [wonDealId], references: [id], onDelete: Cascade)
  statement       Statement?

  @@unique([wonDealId, index])
}

model Statement {
  // V2 §7 — generated from a checked milestone; then visible in the closer's Payments
  id             String       @id @default(cuid())
  code           String       @unique // ST-#### sequential
  milestoneId    String       @unique
  clientName     String
  milestoneLabel String
  milestoneValue Int // piasters
  percentBp      Int // % of the milestone, basis points
  amount         Int // piasters the closer receives
  adjustments    Int          @default(0) // piasters, signed
  expectedDate   DateTime?
  closerUserId   String?
  closerLabel    String
  status         String       @default("pending") // pending | paid
  paidAt         DateTime?
  milestone      Milestone    @relation(fields: [milestoneId], references: [id])
  proofs         Attachment[] // payment proof image (V2 §7)
  createdAt      DateTime     @default(now())
}

model Notification {
  // V2 §10 — in-app; userId null = every admin
  id        String    @id @default(cuid())
  userId    String?
  type      String // meeting_request | ready_to_close | registration | mention
  title     String
  body      String
  leadId    String?
  readAt    DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Attachment {
  // kinds: cv | recording | proposal | contract | payment_proof (V2 §5/§7)
  id                String           @id @default(cuid())
  kind              String
  portalRepId       String?          @unique
  partnerProspectId String?
  wonDealId         String?
  statementId       String?
  filename          String
  storageKey        String
  mime              String
  size              Int
  rep               PortalRep?       @relation(fields: [portalRepId], references: [id])
  prospect          PartnerProspect? @relation(fields: [partnerProspectId], references: [id], onDelete: Cascade)
  wonDeal           WonDeal?         @relation(fields: [wonDealId], references: [id])
  statement         Statement?       @relation(fields: [statementId], references: [id])
  createdAt         DateTime         @default(now())
}

model LeadComment {
  // founder: a mini chat inside every lead — questions, follow-ups, @mentions,
  // so whoever talks to the lead has the full picture. Author label survives
  // account deletion (ActivityLog convention).
  id           String   @id @default(cuid())
  leadId       String
  authorUserId String?
  authorLabel  String
  body         String
  mentions     String   @default("[]") // JSON [{userId,name}] — resolved server-side
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User?    @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([leadId, createdAt])
}

model ActivityLog {
  // §5.6
  id         String   @id @default(cuid())
  entityType String // lead | partner_prospect | won_deal | client | partner | portal_rep | statement | user
  entityId   String
  actorId    String?
  actorLabel String
  action     String
  fromStage  String?
  toStage    String?
  trigger    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model UndoEntry {
  // Founder: "an undo button that undoes the last action I did on the system"
  // (ADR-045). One row per UNDOABLE mutation, written inside that mutation's
  // own transaction. `payload` is the INVERSE — a snapshot of the prior state
  // plus the ids this action created — never a replay log. Rows are consumed
  // (never deleted) so a double-click cannot apply twice, and non-undoable
  // actions consume the user's outstanding rows so the button never offers to
  // revert something older than the last thing that happened.
  id          String    @id @default(cuid())
  userId      String // undo is personal: only its author may apply it
  kind        String // lead_event | lead_no_answer | lead_ready | lead_archive | lead_update | lead_create | prospect_event
  entityType  String // lead | partner_prospect
  entityId    String
  label       String // English snapshot of what will be reverted
  labelAr     String // Arabic snapshot (bilingual UI, V5)
  fingerprint String // the entity's updatedAt at write time — changed since = refuse
  payload     Json
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?

  @@index([userId, consumedAt, createdAt])
}
